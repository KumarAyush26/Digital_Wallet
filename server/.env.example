# ─── Server Configuration ───────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── JWT Authentication ──────────────────────────────────────────────────────
JWT_SECRET=super_secret_jwt_key_change_this_in_production_min_64_chars_long
JWT_EXPIRES_IN=7d

# ─── MongoDB (leave blank to use embedded MongoMemoryServer) ─────────────────
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/digital_wallet?retryWrites=true&w=majority

# ─── CORS (Frontend URL) ─────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173
